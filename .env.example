# OpenAI (apenas Whisper)
OPENAI_API_KEY=sk-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar
GCAL_NEOSTORE_ID=id_do_calendario_neostore@group.calendar.google.com
