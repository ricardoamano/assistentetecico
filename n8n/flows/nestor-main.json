{
  "name": "NESTOR — Fluxo Principal",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nestor-webhook",
        "options": {}
      },
      "id": "node_webhook",
      "name": "1. Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "senderPhone",
              "value": "={{ $json.body.data.key.remoteJid.replace('@s.whatsapp.net', '') }}"
            },
            {
              "name": "instanceName",
              "value": "={{ $json.body.instance }}"
            },
            {
              "name": "messageType",
              "value": "={{ $json.body.data.message && $json.body.data.message.audioMessage ? 'AUDIO' : 'TEXT' }}"
            },
            {
              "name": "rawMessage",
              "value": "={{ $json.body.data.message ? ($json.body.data.message.conversation || ($json.body.data.message.extendedTextMessage ? $json.body.data.message.extendedTextMessage.text : '')) : '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_extract",
      "name": "2. Extrair dados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.messageType }}",
        "rules": {
          "rules": [
            {
              "value2": "AUDIO",
              "output": 0
            }
          ]
        },
        "fallbackOutput": 1
      },
      "id": "node_switch_type",
      "name": "3. Tipo de mensagem?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "functionCode": "// Nó placeholder para Whisper\n// Substitua por HTTP Request para OpenAI Whisper\n// POST https://api.openai.com/v1/audio/transcriptions\nconst items = $input.all();\nreturn [{ json: { text: '[transcrição do áudio]', processedMessage: '[transcrição do áudio]' } }];"
      },
      "id": "node_whisper",
      "name": "4a. Whisper (configurar)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [900, 160]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "processedMessage",
              "value": "={{ $('2. Extrair dados').item.json.rawMessage }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_set_text",
      "name": "4b. Mensagem texto",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 440]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/authorized_users?phone=eq.{{ $('2. Extrair dados').item.json.senderPhone }}&active=eq.true&select=id,name,role",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_auth_check",
      "name": "5. Verificar auth",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "node_if_authorized",
      "name": "6. Autorizado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $('2. Extrair dados').item.json.instanceName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $('2. Extrair dados').item.json.senderPhone }}"
            },
            {
              "name": "text",
              "value": "Oi, não reconheço seu número aqui. Fala com o Amano para liberar seu acesso. 👋"
            }
          ]
        },
        "options": {}
      },
      "id": "node_unauthorized_msg",
      "name": "7a. Não autorizado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1560, 460]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "userName",
              "value": "={{ $json[0].name }}"
            },
            {
              "name": "userRole",
              "value": "={{ $json[0].role }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_set_user",
      "name": "7b. Dados do usuário",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1560, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/conversation_history?phone=eq.{{ $('2. Extrair dados').item.json.senderPhone }}&order=created_at.desc&limit=10&select=role,content",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_get_history",
      "name": "8. Buscar histórico",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1780, 160]
    },
    {
      "parameters": {
        "functionCode": "const phone = $('2. Extrair dados').item.json.senderPhone;\nconst userName = $('7b. Dados do usuário').item.json.userName;\nconst userRole = $('7b. Dados do usuário').item.json.userRole;\nconst message = $('4b. Mensagem texto').item.json.processedMessage || $('4a. Whisper (configurar)').item.json.processedMessage || '';\n\nreturn [{ json: { phone, userName, userRole, message } }];"
      },
      "id": "node_prepare_classify",
      "name": "9a. Preparar contexto",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [2000, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-6"
            },
            {
              "name": "max_tokens",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "node_classify_intent",
      "name": "9b. Claude — Classificar intenção",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2220, 160],
      "notes": "ATENÇÃO: Configure o body manualmente após importar.\nVer instrução no README do projeto."
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.content[0].text.trim() }}",
        "rules": {
          "rules": [
            { "value2": "SUPORTE_TECNICO", "output": 0 },
            { "value2": "AGENDA", "output": 1 },
            { "value2": "ESCALACAO", "output": 2 }
          ]
        },
        "fallbackOutput": 3
      },
      "id": "node_switch_intent",
      "name": "10. Rotear intenção",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [2440, 160]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "finalResponse",
              "value": "Não entendi bem. Pode repetir? Posso te ajudar com: suporte técnico, agenda ou escalação."
            },
            {
              "name": "intent",
              "value": "FALLBACK"
            }
          ]
        },
        "options": {}
      },
      "id": "node_fallback",
      "name": "11d. Fallback",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2660, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/conversation_history",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $('2. Extrair dados').item.json.senderPhone }}"
            },
            {
              "name": "role",
              "value": "assistant"
            },
            {
              "name": "content",
              "value": "={{ $json.finalResponse }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_save_history",
      "name": "12. Salvar histórico",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/audit_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $('2. Extrair dados').item.json.senderPhone }}"
            },
            {
              "name": "intent",
              "value": "={{ $json.intent }}"
            },
            {
              "name": "input",
              "value": "={{ $('4b. Mensagem texto').item.json.processedMessage ?? '' }}"
            },
            {
              "name": "output",
              "value": "={{ $json.finalResponse }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_audit_log",
      "name": "13. Salvar audit_log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [3100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $('2. Extrair dados').item.json.instanceName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $('2. Extrair dados').item.json.senderPhone }}"
            },
            {
              "name": "text",
              "value": "={{ $json.finalResponse }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_send_response",
      "name": "14. Enviar resposta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [3320, 300]
    }
  ],
  "connections": {
